# ── Core ─────────────────────────────────────────────
# Gemini powers every analyzer (chat insights + ad creative analysis). Extra keys are rotated on rate limits.
GEMINI_API_KEY=
GEMINI_API_KEY_2=
GEMINI_API_KEY_3=
GEMINI_API_KEY_4=
NEXT_PUBLIC_GEMINI_MODEL=
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Password for the dashboard gate (required; empty = nobody can sign in)
APP_PASSWORD=

# ── Database (Neon / Postgres) ───────────────────────
DATABASE_URL=

# ── Payments & email (optional) ──────────────────────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID=
STRIPE_PRODUCT_ID=
RESEND_API_KEY=
CLERK_SECRET_KEY=
SHOPIFY_WEBHOOK_SECRET=

# ── Ad Tracker (optional) ────────────────────────────
FB_ACCESS_TOKEN=
FB_AD_ACCOUNT_ID=
REPORTING_TIMEZONE=UTC
NEXT_PUBLIC_REPORTING_TIMEZONE=UTC

# ── Server-side conversion APIs (optional) ───────────
FACEBOOK_PIXEL_ID=
FACEBOOK_ACCESS_TOKEN=
FACEBOOK_TEST_EVENT_CODE=
PINTEREST_AD_ACCOUNT_ID=
PINTEREST_ACCESS_TOKEN=
REDDIT_PIXEL_ID=
REDDIT_ACCESS_TOKEN=

# ── Optional ─────────────────────────────────────────
NEXT_PUBLIC_RUNWARE_API_KEY=
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_SERVICE_ACCOUNT_KEY=
